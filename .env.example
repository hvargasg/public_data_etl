# Copia este archivo a .env y completa los valores.
# NO subas .env al repositorio.
#
# En desarrollo local los comandos usan este archivo. En el servidor los
# secretos vienen de Infisical (ver la sección de Infisical más abajo).

# Conexión SQL Server
DB_SERVER=servidor\instancia
DB_NAME=DataLake
DB_SCHEMA=datos_publicos
DB_USER=usuario
DB_PASSWORD=

# Opcionales de la conexión
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# Infisical (solo servidor; las credenciales de la identity viven en machine.env)
# SECRETS_SOURCE=auto
# INFISICAL_MACHINE_FILE=/etc/infisical/machine.env
# INFISICAL_ENV=prod
# INFISICAL_PATH=/public_data_etl
# INFISICAL_API_URL=http://127.0.0.1:8081

# Opcionales del contenedor. Se pasan como variables de entorno al wrapper;
# ETL_DOCKER_NETWORK también se puede definir aquí.
# ETL_IMAGE=public-data-etl:latest
# ETL_DATA=data
# ETL_UID=1000:1000
# ETL_DOCKER_NETWORK=
